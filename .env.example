# Application Configuration
PROJECT_NAME="DGDA RDC API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Tokens
# Generate secret using: openssl rand -hex 32
SECRET_KEY="dgda_super_secret_production_key_change_in_production_2026_xyz"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: Async SQLite for instant local dev, switch to PostgreSQL in production)
DATABASE_URL="sqlite+aiosqlite:///./dgda.db"
# Example PostgreSQL URL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/dgda_db"

# Database Connection Pool Settings (for handling high traffic / concurrency)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# CORS Allowed Origins (Separate by comma, or * for dev)
BACKEND_CORS_ORIGINS=["*"]

# Rate Limiting (Traffic Protection against DDoS and Brute Force attacks)
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="5/minute"

# Brevo Email API
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"
BREVO_SENDER_EMAIL="makflutter@gmail.com"
BREVO_SENDER_NAME="DGDA Douane"

# Email Service (Resend API - Fallback)
RESEND_API_KEY="re_your_api_key_here"
EMAILS_FROM="DGDA Douane <makflutter@gmail.com>"
OTP_EXPIRE_MINUTES=10
